-- Default categories store a stable key in `name` (translated at display time).
CREATE TABLE DocumentCategories (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    icon TEXT NOT NULL,
    color INTEGER NOT NULL,
    isDefault INTEGER NOT NULL DEFAULT 0
);

CREATE UNIQUE INDEX idx_categories_name ON DocumentCategories(name);

INSERT INTO DocumentCategories(name, icon, color, isDefault) VALUES
    ('driving_licence', 'car', 4282339765, 1),
