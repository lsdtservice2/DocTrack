selectAll:
SELECT * FROM DocumentCategories ORDER BY isDefault DESC, id ASC;

selectById:
SELECT * FROM DocumentCategories WHERE id = ?;

insert:
INSERT INTO DocumentCategories(name, icon, color, isDefault) VALUES (?, ?, ?, 0);

insertWithId:
INSERT OR REPLACE INTO DocumentCategories(id, name, icon, color, isDefault) VALUES (?, ?, ?, ?, ?);

update:
UPDATE DocumentCategories SET name = ?, icon = ?, color = ? WHERE id = ? AND isDefault = 0;

delete:
DELETE FROM DocumentCategories WHERE id = ? AND isDefault = 0;

countDocuments:
SELECT COUNT(*) FROM Documents WHERE categoryId = ?;

deleteAll:
DELETE FROM DocumentCategories;

lastInsertId:
SELECT last_insert_rowid();
